    CostCodeCOL = sOrgLevels + 10
    Custom1COL = sOrgLevels + 11
    Custom2COL = sOrgLevels + 12
    Custom3COL = sOrgLevels + 13
    Custom4COL = sOrgLevels + 14
    EmployeeBudgetCOL = sOrgLevels + 15
    NetworkTypeCOL = sOrgLevels + 16
    Feature1COL = sOrgLevels + 17
    Feature2COL = sOrgLevels + 18
    Feature3COL = sOrgLevels + 19
    Feature4COL = sOrgLevels + 20
    Feature5COL = sOrgLevels + 21
    Feature6COL = sOrgLevels + 22
    Feature7COL = sOrgLevels + 23
    Feature8COL = sOrgLevels + 24
    Feature9COL = sOrgLevels + 25
    Feature0COL = sOrgLevels + 26

    AssetTypeCOL = sOrgLevels + 27
    AssetManafacturerCOL = sOrgLevels + 28
    AssetNameCOL = sOrgLevels + 29
    IMEESNNumberCOL = sOrgLevels + 30
    AssetNumberCOL = sOrgLevels + 31
    SerialNumberCOL = sOrgLevels + 32

  End Sub
  Sub ErrorMessage(ByVal ErrorText, ByVal ErrorLine, ByVal ErrorType)
    Dim ErrorColor As String
    Dim sErrorType As String
    If ErrorType = 3 Then
      sErrorType = "Critical "
      ErrorColor = "#ff0000"
      CriticalError = True
      'hlProcess.Visible = False
    ElseIf ErrorType = 2 Then
      sErrorType = "Possible "
      ErrorColor = "#ff6633"
    End If
    lblStatis.Text = lblStatis.Text & "<font color='" & ErrorColor & "'><b>" & sErrorType & "Error :</b></font> " & ErrorText & "  <font color='" & ErrorColor & "'><b>On Line :</b></font> <a href='#" & ErrorLine & "'>" & ErrorLine & "</a><br>" & vbCrLf
  End Sub
End Class
