      'close popup window
      mySelectQuery = "SELECT LineOutput FROM AssetImporterLines WHERE (ClientID = " & sClientID & ") AND (FileName = '" & Request("FileName") & "') ORDER BY UID"
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
      If MyConnection.State.ToString = "Closed" Then
        MyConnection.Open()
      End If
      myReader = MyCommand.ExecuteReader()
      Do While myReader.Read()
        Label1.Text = Label1.Text & myReader("LineOutput").ToString()
        Trace.Write(myReader("LineOutput").ToString())
      Loop
      myReader.Close()
