          mySelectQuery = "SELECT UID FROM NetworkType WHERE (NetworkType = '" & NetworkType & "')"
          MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
          If MyConnection.State.ToString = "Closed" Then
            MyConnection.Open()
          End If
          myReader = MyCommand.ExecuteReader()
          If myReader.Read() Then
            'return UID for network type
            NetworkTypeID = myReader("UID")
          Else
            'insert new uid
            NetworkTypeID = -1
          End If
          myReader.Close()

        End If

        mySelectQuery = "SELECT NetworkTypeID, Feature1, Feature2, Feature3, Feature4, Feature5, Feature6, Feature7, Feature8, Feature9, Feature0 FROM Service WHERE (ClientID = " & sClientID & ") AND (ServiceNumber = '" & ServiceNumber & "') AND (ServiceID = " & sServiceID & ")"
        Trace.Write(mySelectQuery)
