      MyConnection2 = New System.Data.SqlClient.SqlConnection(Session("OperationalDB"))
      MyConnection3 = New System.Data.SqlClient.SqlConnection(Session("OperationalDB"))
      CriticalError = False
      lblStatis.Text = ""
      Call GetFileDetails()
      sOutputLabel = "<table class='stdTable' width='580' border='1' bordercolor='#000000' cellspacing='0' cellpadding='2'>" & vbCrLf
