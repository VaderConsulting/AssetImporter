      Response.Write("msgWindow.close();" & vbCrLf)
      Response.Write("</Script>" & vbCrLf & vbCrLf)
      Call ClearTables(sClientID)
    End If
  End Sub
  Sub GetFileDetails()
    lineCounter = 1
    mySelectQuery = "SELECT * FROM ImportAssetRegister WHERE UID = "REDACTED"UID")
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)

    If MyConnection.State.ToString = "Closed" Then
      MyConnection.Open()
    End If
    myReader = MyCommand.ExecuteReader()
    myReader.Read()

    sUploadFileName = myReader("UploadFileName").ToString()
    suploadDate = myReader("uploadDate").ToString()
    sUploadUser = myReader("UploadUser").ToString()
    sUploadChecked = myReader("UploadChecked").ToString()
    sUploadVerified = myReader("UploadVerified").ToString()
    sUploadSuccessful = myReader("UploadSuccessful").ToString()
    sUploadRemoved = myReader("UploadRemoved").ToString()
    sUploadFormat = myReader("UploadFormat").ToString()
    sClientID = myReader("ClientID").ToString()
    sRevisionNumber = myReader("RevisionNumber").ToString()
    sImportedBy = myReader("ImportedBy").ToString()
    sImportType = myReader("ImportType").ToString()
    sMoveType = myReader("MoveType").ToString()
    sMoveDate = myReader("MoveDate").ToString()
    sImportState = GetImportState(myReader("ImportState").ToString())

    'set lables
    lblClientname.Text = getClientName(sClientID)
    lblFileName.Text = sUploadFileName
    lblRevisionNumber.Text = sRevisionNumber
    lblDateUploaded.Text = suploadDate
    lblImportedBy.Text = sImportedBy
    lblOrgUnitlevels.Text = sOrgLevels
    lblImportType.Text = GetImportType(sImportType)
    lblMoveType.Text = GetMoveType(sMoveType)
    lblMoveDate.Text = sMoveDate
    lblImportState.Text = sImportState
    myReader.Close()

    Call ClearTables(sClientID)

    'Insert all the current org units and their respective Parents into the Temp Table
    mySelectQuery = "SELECT OrgUnitID, OrgUnitParent, OrgUnitName FROM ClientOrganisationUnit WHERE (ClientID  = " & sClientID & ")"
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
    If MyConnection.State.ToString = "Closed" Then
      MyConnection.Open()
    End If
    myReader = MyCommand.ExecuteReader()
    Do While myReader.Read()
      'Insert org unit into Temp Table
      mySelectQuery = "INSERT INTO ImportTempOrgUnits (orgID, name, parent, clientID) VALUES ('" & myReader("OrgUnitID") & "', '" & Replace(LCase(Trim(myReader("OrgUnitName"))), "'", "''") & "', " & myReader("OrgUnitParent") & ", " & sClientID & ")"
      'Trace.Write(mySelectQuery)
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
      If MyConnection3.State.ToString = "Closed" Then
        MyConnection3.Open()
      End If
      MyCommand.ExecuteNonQuery()
      MyConnection3.Close()
    Loop
    myReader.Close()

  End Sub
  Sub ClearTables(ByVal sClientID)
    'Remove All org units listed in the Temp Table for the selected client
    mySelectQuery = "DELETE FROM ImportTempOrgUnits WHERE (ClientID = " & sClientID & ")"
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
    If MyConnection.State.ToString = "Closed" Then
      MyConnection.Open()
    End If
    MyCommand.ExecuteNonQuery()
    MyConnection.Close()
    mySelectQuery = "DELETE FROM ImportTempService WHERE (ClientID = " & sClientID & ")"
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
    If MyConnection.State.ToString = "Closed" Then
      MyConnection.Open()
    End If
    MyCommand.ExecuteNonQuery()
    MyConnection.Close()
    mySelectQuery = "DELETE FROM AssetImporterLines WHERE (ClientID = " & sClientID & ") AND (FileName = '" & Request("FileName") & "')"
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
    If MyConnection.State.ToString = "Closed" Then
      MyConnection.Open()
    End If
    MyCommand.ExecuteNonQuery()
    MyConnection.Close()
  End Sub
  Function getClientName(ByVal ClientID)
    mySelectQuery = "SELECT ClientName FROM Client WHERE ClientID = " & ClientID
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection2)
    If MyConnection2.State.ToString = "Closed" Then
      MyConnection2.Open()
    End If
    myReader2 = MyCommand.ExecuteReader()
    myReader2.Read()
    Return myReader2("ClientName")
    myReader2.Close()
  End Function
  Function GetImportState(ByVal StateID)
    Dim tempstr As String
    mySelectQuery = "SELECT State FROM State WHERE UID = "REDACTED"Closed" Then
      MyConnection2.Open()
    End If
    myReader2 = MyCommand.ExecuteReader()
    If myReader2.Read() Then
      tempstr = myReader2("State")
    End If
    myReader2.Close()
    Return tempstr
  End Function
  Public Function GetImportType(ByVal typeID)
    If typeID = "1" Then
      Return "Add Assets"
    ElseIf typeID = "2" Then
      Return "Skip Assets"
    ElseIf typeID = "3" Then
      Return "Update Assets"
    ElseIf typeID = "4" Then
      Return "Org Structure"
    Else
      Return "Error"
    End If
  End Function
  Public Function GetMoveType(ByVal typeID)
    If typeID = "1" Then
      Return "Move All"
    ElseIf typeID = "2" Then
      Return "Move From"
    ElseIf typeID = "3" Then
      Return "Don't Move"
    Else
      Return "Error"
    End If
  End Function
  Sub GetCSVData()
    Dim FileLocation As String
    FileLocation = Server.MapPath("AssetSheets") & "\" & Request("FileName")
    Dim sr As StreamReader = New StreamReader(FileLocation)
    Dim line As String
    Dim counter As Integer
    counter = 0
    Do
      line = sr.ReadLine()
      line = Replace(Trim(line), "'", "''")
      line = Replace(Trim(line), """", "")
      '      Trace.Write("Start If")
      If lineCounter > 2 Then
        If counter > 2 Then
          line = Nothing
        ElseIf Left(Trim(line), 2) = ",," Or Trim(line) = "" Then
          Call ErrorMessage("Line Skipped", lineCounter, 2)
          sOutputLabel = sOutputLabel & "<tr class='even'><td class='Possible' colspan='99'><a NAME='" & lineCounter & "'></a>" & lineCounter & "</td></tr>" & vbCrLf
          counter = counter + 1
        Else
          counter = 0
          Dim aLine() = Split(line, ",")
          Call ProcessData(aLine)
        End If

        sOutputLabel = Replace(sOutputLabel, "'", "''")

        mySelectQuery = "INSERT INTO AssetImporterLines (LineOutput, ClientID, FileName) VALUES ('" & sOutputLabel & "', " & sClientID & ", '" & Request("FileName") & "')"
        '        Trace.Write(mySelectQuery)
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
        If MyConnection3.State.ToString = "Closed" Then
          MyConnection3.Open()
        End If
        MyCommand.ExecuteNonQuery()
        MyConnection3.Close()
        MyCommand.Dispose()
        sOutputLabel = ""
      Else
        If lineCounter = 2 Then
          'Read in and return org levels
          Call ProcessTitle(line)
        End If
      End If
      lineCounter = lineCounter + 1
    Loop Until line Is Nothing
    sr.Close()
    sOutputLabel = sOutputLabel & "<tr class='heading'><td colspan='99' height='2'>End File</td></tr></table>" & vbCrLf
  End Sub
  Sub GetExcelData()
    Dim conn As New OleDbConnection
    Dim fileReader As OleDbDataReader
    Dim connString As String
    Dim cmd As New OleDbCommand
    Dim FilePath As String
    Dim lineArray As Array
    Dim FileLocation As String
    FileLocation = Server.MapPath("AssetSheets") & "\" & Request("FileName")

    ' Set the connection string.
    connString = "Data Source='" & FileLocation & "';Provider=Microsoft.Jet.OLEDB.4.0;Extended Properties=""Excel 8.0;IMEX=1;HDR=NO;"""

    ' Open the connection.
    conn.ConnectionString = connString
    conn.Open()

    'get the sheet names
    Dim dt As DataTable
    dt = conn.GetOleDbSchemaTable(OleDbSchemaGuid.Tables, Nothing)
    Dim excelSheets() As String = New String(dt.Rows.Count) {}
    Dim i As Integer = 0
    'get the sheet names
    Dim row As DataRow
    For Each row In dt.Rows
      excelSheets(i) = row("TABLE_NAME").ToString()
      i = i + 1
    Next
    i = 0

    'Set the command properties.
    cmd.Connection = conn
    cmd.CommandText = "SELECT * FROM [" & excelSheets(0) & "]"

    ' Get the OleDbDataReader
    ' and do some processing with it.
    fileReader = cmd.ExecuteReader(CommandBehavior.CloseConnection)
    lineCounter = 1
    Dim counter As Integer = 0
    While (fileReader.Read())
      'Load in file details
      If counter < 2 Then
        If lineCounter <> 1 Then
          Dim line As String
          i = 0
          line = ""
          While i < fileReader.FieldCount - 1
            line = line & Trim(fileReader(i).ToString()) & ","
            i = i + 1
          End While

          line = Replace(Trim(line), "'", "''")
          line = Replace(Trim(line), """", "")

          If Left(line, 10) = ",,,,,,,,,," Then
            Call ErrorMessage("Line Skipped", lineCounter, 2)
            sOutputLabel = sOutputLabel & "<tr class='even'><td class='Possible' colspan='99'><a NAME='" & lineCounter & "'></a>" & lineCounter & "</td></tr>" & vbCrLf
            counter = counter + 1
          Else
            counter = 0
            If lineCounter = 2 Then
              ProcessTitle(line)
            Else
              Dim aLine() = Split(line, ",")
              Call ProcessData(aLine)
            End If

          End If
          sOutputLabel = Replace(sOutputLabel, "'", "''")

          mySelectQuery = "INSERT INTO AssetImporterLines (LineOutput, ClientID, FileName) VALUES ('" & sOutputLabel & "', " & sClientID & ", '" & Request("FileName") & "')"
          '        Trace.Write(mySelectQuery)
          MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
          If MyConnection3.State.ToString = "Closed" Then
            MyConnection3.Open()
          End If
          MyCommand.ExecuteNonQuery()
          MyConnection3.Close()
          MyCommand.Dispose()
          sOutputLabel = ""


        End If
        lineCounter = lineCounter + 1
      End If

    End While
    fileReader.Close()
    sOutputLabel = sOutputLabel & "<tr class='heading'><td colspan='99' height='2'>End File</td></tr></table>" & vbCrLf
  End Sub
  Sub ProcessTitle(ByVal line)
    Dim aLine() = Split(line, ",")
    Call SetOrgUnitLevels(aLine)
    'output title row
    sOutputLabel = sOutputLabel & "<tr class='even'>" & vbCrLf
    sOutputLabel = sOutputLabel & "<td class='title'>#</td>" & vbCrLf
    Dim i As Integer = 0
    For i = 1 To sOrgLevels
      sOutputLabel = sOutputLabel & "<td class='title'>Org Level " & i & "</td>" & vbCrLf
    Next
    If sImportType.ToString() <> "4" Then
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Service</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>First Name</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Last Name</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Carrier</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Account Number</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Rate Plan</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Contract<br>End Date</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Email</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Cost Code</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Custom1</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Custom2</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Custom3</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Custom4</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Employee Budget</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Network Type</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Feature1</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Feature2</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Feature3</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Feature4</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Feature5</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Feature6</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Feature7</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Feature8</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Feature9</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='title' nowrap>Feature0</td>" & vbCrLf
      'Repeating
      If noAssets > 0 And sImportType <> "2" Then
        Dim i2 As Integer
        For i2 = 1 To noAssets
          sOutputLabel = sOutputLabel & "<td class='title' nowrap>Asset Type</td>" & vbCrLf
          sOutputLabel = sOutputLabel & "<td class='title' nowrap>Asset Manufacturer</td>" & vbCrLf
          sOutputLabel = sOutputLabel & "<td class='title' nowrap>Asset Name</td>" & vbCrLf
          sOutputLabel = sOutputLabel & "<td class='title' nowrap>IMEI / ESN / MAC<br>Number</td>" & vbCrLf
          sOutputLabel = sOutputLabel & "<td class='title' nowrap>Asset Number</td>" & vbCrLf
          sOutputLabel = sOutputLabel & "<td class='title' nowrap>Serial Number</td>" & vbCrLf
        Next
      End If
    End If
    sOutputLabel = sOutputLabel & "</tr>" & vbCrLf
  End Sub
  Sub SetOrgUnitLevels(ByVal aline As Array)
    Dim i As Object
    Dim zz As Boolean
    Dim orgLevels As Integer
    zz = True
    orgLevels = 0
    For Each i In aline
      If zz Then
        If sImportType.ToString() = "4" Then
          If aline(orgLevels).ToString() <> "Destination Org Unit" Then
            orgLevels = orgLevels + 1
          Else
            sOrgLevels = orgLevels ' - 1
            zz = False
          End If
        Else
          If aline(orgLevels).ToString() <> "Service Number" Then
            orgLevels = orgLevels + 1
          Else
            sOrgLevels = orgLevels - 1
            zz = False
          End If
        End If

      End If
    Next i
    lblOrgUnitlevels.Text = sOrgLevels
    Call SetColCount()
    Call CheckAssetCount(UBound(aline))

  End Sub
  Sub ProcessData(ByVal DetailsArray As Array)
    'check that row is valid (containd critical information)
    Response.Write("<script> msgWindow.document.StatusForm.tbxStatus.value='Validating Line " & lineCounter & "'; </script>" & vbCrLf)
    Trace.Write(lineCounter)
    Dim i As Integer = 0
    Dim DetailsLength As String
    If sImportType <> "2" Or sImportType <> 4 Then
      Call CheckAssetCount(UBound(DetailsArray))
    End If
    DetailsArray = CheckArraySize(DetailsArray)
    OrgUnitParentID = 0
    'Output TR header
    'sOutputLabel = ""
    sOutputLabel = sOutputLabel & "<tr class='even'>" & vbCrLf
    sOutputLabel = sOutputLabel & "<td class='white'><a NAME='" & lineCounter & "'>" & lineCounter & "</a></td>" & vbCrLf
    For i = 0 To sOrgLevels - 1
      'Check if the org unit is in the Temp table
      If i = 0 And DetailsArray(i) = "" Then
        ErrorMessage("You MUST enter in an Org Structure.", lineCounter, 3)
        sOutputLabel = sOutputLabel & "<td class='Critical'>-</td>" & vbCrLf
      Else
        Call ProcessOrgUnit(DetailsArray(i), OrgUnitParentID)
      End If
    Next
    If sImportType.ToString() <> "4" Then
      Call ProcessService(DetailsArray(ServiceNumberCOL))
      Call ProcessUser(DetailsArray(FirstNameCOL), DetailsArray(LastNameCOL))
      Call ProcessServiceDetails(DetailsArray(CarrierNameCOL), DetailsArray(ServiceNumberCOL), DetailsArray(AccountNumberCOL), DetailsArray(RatePlanCOL), DetailsArray(ContractEndDateCOL))
      Call ProcessUserDetails(DetailsArray(FirstNameCOL), DetailsArray(LastNameCOL), DetailsArray(PhoneUserEmailCOL), DetailsArray(CostCodeCOL), DetailsArray(Custom1COL), DetailsArray(Custom2COL), DetailsArray(Custom3COL), DetailsArray(Custom4COL), DetailsArray(EmployeeBudgetCOL))
      Call PricessServiceOptions(DetailsArray(NetworkTypeCOL), DetailsArray(ServiceNumberCOL), DetailsArray(Feature1COL), DetailsArray(Feature2COL), DetailsArray(Feature3COL), DetailsArray(Feature4COL), DetailsArray(Feature5COL), DetailsArray(Feature6COL), DetailsArray(Feature7COL), DetailsArray(Feature8COL), DetailsArray(Feature9COL), DetailsArray(Feature0COL))
      If sImportType <> "2" Then
        Call ProcessAssets(DetailsArray)
      End If
      sOutputLabel = sOutputLabel & "</tr>" & vbCrLf
    End If
  End Sub
  Function ProcessOrgUnit(ByVal OrgUnitName, ByVal ParentID)
    'check where parentID = 0 and Name matches, if not then caution output
    OrgUnitName = Trim(OrgUnitName.ToString())
    If OrgUnitName = "" Then
      sOutputLabel = sOutputLabel & "<td class='white'>-</td>"
    Else
      If Len(OrgUnitName) > 50 Then
        'error
        ErrorMessage("Org Unit <b>'" & OrgUnitName & "'</b> Length is to long, maximum 50 chars", lineCounter, 3)
        sOutputLabel = sOutputLabel & "<td class='Critical'>" & OrgUnitName & "</td>" & vbCrLf
      Else

        mySelectQuery = "SELECT * FROM ImportTempOrgUnits WHERE Name = '" & OrgUnitName & "' AND  ClientID = " & sClientID
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
        If MyConnection.State.ToString = "Closed" Then
          MyConnection.Open()
        End If
        myReader.Close()
        myReader = MyCommand.ExecuteReader()
        If myReader.Read() Then
          'Org Unit in db. caution, check for org unit in different location.
          If myReader("Parent") = ParentID Then
            sOutputLabel = sOutputLabel & "<td class='white'>" & OrgUnitName & "</td>" & vbCrLf
            OrgUnitParentID = myReader("OrgID")
          Else
            ErrorMessage("Org Unit <b>'" & OrgUnitName & "'</b> structure invalid", lineCounter, 3)
            sOutputLabel = sOutputLabel & "<td class='Critical'>" & OrgUnitName & "</td>" & vbCrLf
          End If
        Else
          'New Org Unit
          myReader.Close()
          Call InsertNewOrgUnit(OrgUnitName, ParentID)
          sOutputLabel = sOutputLabel & "<td class='New'>" & OrgUnitName & "</td>" & vbCrLf
        End If
        myReader.Close()

      End If

    End If
  End Function
  Sub InsertNewOrgUnit(ByVal OrgUnitName, ByVal OrgUnitParent)
    mySelectQuery = "INSERT INTO ImportTempOrgUnits (name, parent, clientID) VALUES ('" & OrgUnitName.ToString() & "', " & OrgUnitParent.ToString & ", " & sClientID & ") ;select @@identity"
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
    myReader.Close()
    myReader3 = MyCommand.ExecuteReader()
    myReader3.Read()
    OrgUnitParentID = myReader3.Item(0).ToString()
    myReader3.Close()
    mySelectQuery = "UPDATE ImportTempOrgUnits SET OrgID = " + OrgUnitParentID.ToString() + " WHERE UID = "REDACTED"Closed" Then
      MyConnection.Open()
    End If
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
    MyCommand.ExecuteNonQuery()
  End Sub
  Sub ProcessService(ByVal ServiceNumber)
    Dim tempmobile As String
    Dim intCounter As Integer
    tempmobile = ""
    ' Strip away everything except numerals
    For intCounter = 1 To Len(ServiceNumber)
      If IsNumeric(Mid(ServiceNumber, intCounter, 1)) Then
        tempmobile = tempmobile & Mid(ServiceNumber, intCounter, 1)
      End If
    Next

    ServiceNumber = tempmobile

    sServiceID = ""
    If ServiceNumber = "" Then
      Call ErrorMessage("Blank Service", lineCounter, 2)
      sOutputLabel = sOutputLabel & "<td class='Possible'>-</td>" & vbCrLf
    Else
      Dim RepeatService As Boolean
      RepeatService = False

      mySelectQuery = "SELECT ServiceNumber FROM ImportTempService WHERE (ServiceNumber = '" & ServiceNumber & "') AND (ClientID = " & sClientID & ")"
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
      If MyConnection.State.ToString = "Closed" Then
        MyConnection.Open()
      End If
      myReader = MyCommand.ExecuteReader()
      If myReader.Read() Then
        RepeatService = True
      End If
      myReader.Close()

      If RepeatService Then
        'error
        sOutputLabel = sOutputLabel & "<td class='Possible'>" & ServiceNumber & "</td>" & vbCrLf
        Call ErrorMessage("Duplicate Service", lineCounter, 2)
      Else
        'no error
        mySelectQuery = "SELECT ServiceNumber, ServiceID, OrgUnitID, UserID FROM Service WHERE (EndDate IS NULL) AND (ServiceNumber = '" & ServiceNumber & "') AND (ClientID = " & sClientID & ")"
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
        If MyConnection.State.ToString = "Closed" Then
          MyConnection.Open()
        End If
        myReader = MyCommand.ExecuteReader()
        If myReader.Read() Then
          'old service
          sServiceID = myReader("ServiceID")
          sServiceUser = myReader("UserID")
          If myReader("OrgUnitID").ToString() = OrgUnitParentID.ToString() Then
            sOutputLabel = sOutputLabel & "<td class='white'>" & ServiceNumber & "</td>" & vbCrLf
          Else
            sOutputLabel = sOutputLabel & "<td class='Move'>" & ServiceNumber & "</td>" & vbCrLf
          End If
        Else
          'new Service
          sOutputLabel = sOutputLabel & "<td class='New'>" & ServiceNumber & "</td>" & vbCrLf


        End If
        myReader.Close()

        mySelectQuery = "INSERT INTO ImportTempService (ServiceNumber, ClientID) VALUES ('" & ServiceNumber & "', " & sClientID & ")"
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
        If MyConnection3.State.ToString = "Closed" Then
          MyConnection3.Open()
        End If
        MyCommand.ExecuteNonQuery()
        MyConnection3.Close()

      End If

    End If

  End Sub
  Sub ProcessUser(ByVal FirstName, ByVal LastName)
    sUserID = ""
    If FirstName = "" And LastName = "" Then
      Call ErrorMessage("Blank User Name", lineCounter, 2)
      sOutputLabel = sOutputLabel & "<td class='Possible'>-</td>" & "<td class='Possible'>-</td>" & vbCrLf
    Else
      mySelectQuery = "SELECT FirstName, LastName, UserID, OrgUnitID FROM Users WHERE (EndDate IS NULL) AND (ClientID = " & sClientID & ") AND (FirstName = '" & FirstName & "') AND (LastName = '" & LastName & "')"
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
      If MyConnection.State.ToString = "Closed" Then
        MyConnection.Open()
      End If
      myReader = MyCommand.ExecuteReader()
      If myReader.Read() Then
        'Existing User
        sUserID =REDACTED"UserID").ToString()
        If myReader("OrgUnitID").ToString() = OrgUnitParentID.ToString() And myReader("UserID").ToString() = sServiceUser.ToString() Then
          sOutputLabel = sOutputLabel & "<td class='white'>" & FirstName & "</td>" & "<td class='white'>" & LastName & "</td>" & vbCrLf
        Else
          sOutputLabel = sOutputLabel & "<td class='Move'>" & FirstName & "</td>" & "<td class='Move'>" & LastName & "</td>" & vbCrLf
        End If

      Else
        'New User
        sOutputLabel = sOutputLabel & "<td class='New'>" & FirstName & "</td>" & "<td class='New'>" & LastName & "</td>" & vbCrLf
      End If
      myReader.Close()
    End If

  End Sub
  Sub ProcessServiceDetails(ByVal Carrier, ByVal ServiceNumber, ByVal AccountNumber, ByVal RatePlan, ByVal ContractEndDate)
    'Carrier
    If Carrier = "" Then
      ErrorMessage("Carrier <b>'" & Carrier & "'</b> invalid", lineCounter, 3)
      sOutputLabel = sOutputLabel & "<td class='Critical'>" & Carrier & "</td>" & vbCrLf
    Else
      mySelectQuery = "SELECT DISTINCT ProviderName FROM ServiceProvider WHERE (ProviderName = '" & Carrier & "')"
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
      If MyConnection.State.ToString = "Closed" Then
        MyConnection.Open()
      End If
      myReader = MyCommand.ExecuteReader()
      If myReader.Read() Then
        sOutputLabel = sOutputLabel & "<td class='White'>" & Carrier & "</td>" & vbCrLf
      Else
        ErrorMessage("Carrier <b>'" & Carrier & "'</b> invalid", lineCounter, 3)
        sOutputLabel = sOutputLabel & "<td class='Critical'>" & Carrier & "</td>" & vbCrLf
      End If
      myReader.Close()
    End If
    If AccountNumber = "" And RatePlan = "" Then
      sOutputLabel = sOutputLabel & "<td class='white'>-</td>" & vbCrLf
      sOutputLabel = sOutputLabel & "<td class='white'>-</td>" & vbCrLf
    Else
      If ServiceNumber = "" Then
        ErrorMessage("Service Number blank", lineCounter, 2)
        sOutputLabel = sOutputLabel & "<td class='Possible'>" & AccountNumber & "</td>" & vbCrLf
        sOutputLabel = sOutputLabel & "<td class='Possible'>" & RatePlan & "</td>" & vbCrLf
      Else
        If sServiceID = "" Then
          mySelectQuery = "SELECT DISTINCT ServiceProvider.ProviderName, Service.ProviderAccountNumber, ServiceProviderPlans.PlanName, ISNULL(Service.ContractEndDate, '') AS ContractEndDate, Service.ServiceNumber FROM Service INNER JOIN ServiceProvider ON Service.ServiceProviderID = ServiceProvider.UID INNER JOIN ServiceProviderPlans ON ServiceProvider.UID =REDACTED WHERE (Service.ClientID = " & sClientID & ") AND (Service.ServiceNumber = '" & ServiceNumber & "') AND (ServiceProvider.ProviderName = '" & Carrier & "') AND (Service.ProviderAccountNumber = '" & AccountNumber & "')"
        Else
          mySelectQuery = "SELECT DISTINCT ServiceProvider.ProviderName, Service.ProviderAccountNumber, ServiceProviderPlans.PlanName, ISNULL(Service.ContractEndDate, '') AS ContractEndDate, Service.ServiceNumber FROM Service INNER JOIN ServiceProvider ON Service.ServiceProviderID = ServiceProvider.UID INNER JOIN ServiceProviderPlans ON ServiceProvider.UID =REDACTED WHERE (Service.ClientID = " & sClientID & ") AND (ServiceProvider.ProviderName = '" & Carrier & "') AND (Service.ProviderAccountNumber = '" & AccountNumber & "')"
        End If
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
        If MyConnection.State.ToString = "Closed" Then
          MyConnection.Open()
        End If
        myReader = MyCommand.ExecuteReader()
        If myReader.Read() Then
          sOutputLabel = sOutputLabel & "<td class='white'>" & AccountNumber & "</td>" & vbCrLf
          If RatePlan = "" Then
            sOutputLabel = sOutputLabel & "<td class='white'>-</td>" & vbCrLf
          Else
            sOutputLabel = sOutputLabel & "<td class='white'>" & RatePlan & "</td>" & vbCrLf
          End If
        Else
          sOutputLabel = sOutputLabel & "<td class='new'>" & AccountNumber & "</td>" & vbCrLf
          If RatePlan = "" Then
            sOutputLabel = sOutputLabel & "<td class='white'>-</td>" & vbCrLf
          Else
            sOutputLabel = sOutputLabel & "<td class='new'>" & RatePlan & "</td>" & vbCrLf
          End If
        End If
        myReader.Close()

      End If
    End If
    If ContractEndDate = "" Then
      sOutputLabel = sOutputLabel & "<td class='white'>-</td>" & vbCrLf
    Else
      If CDate(ContractEndDate) < Now Then
        ErrorMessage("The contract end date <b>'" & ContractEndDate & "'</b> has past.", lineCounter, 2)
        sOutputLabel = sOutputLabel & "<td class='Possible'>" & ContractEndDate & "</td>" & vbCrLf
      Else
        sOutputLabel = sOutputLabel & "<td class='New'>" & ContractEndDate & "</td>" & vbCrLf
      End If
    End If
  End Sub
