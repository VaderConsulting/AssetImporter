  End Sub
  Function CheckArraySize(ByVal thisLine)
    Dim arrayLength As Integer
    Dim tempStr As String
    Dim i As Integer = 0
    Dim RequiredLength As Integer
    RequiredLength = Feature0COL + (noAssets * 6)
    arrayLength = UBound(thisLine)
    If arrayLength < RequiredLength Then
      tempStr = thisLine(0)
      For i = 1 To arrayLength
        tempStr = tempStr & "," & thisLine(i)
      Next
      For i = 0 To (RequiredLength - arrayLength)
        tempStr = tempStr & ","
      Next
      Return Split(tempStr, ",", -1, 1)
    Else
      Return thisLine
    End If
  End Function
  Sub CheckAssetCount(ByVal arrayLength)
    noAssets = Math.Ceiling((arrayLength - Feature0COL) / 6)
    If noAssets < 0 Then
      noAssets = 0
    End If
  End Sub
  Sub ProcessAssets(ByVal lineArray As Array)
    Dim i As Integer = 0
    Dim assetCounter As Integer
    assetCounter = 0
    Dim invalid As Boolean
    Dim AssetType As Integer
    Dim AssetManafacturer As Integer
    Dim AssetList As Integer
    invalid = False
    If noAssets > 0 Then
      For i = 0 To noAssets - 1
        assetCounter = (i * 6)
        If lineArray(AssetTypeCOL + assetCounter) = "" And lineArray(AssetManafacturerCOL + assetCounter) = "" And lineArray(AssetNameCOL + assetCounter) = "" Then
          'output blank asset
          sOutputLabel = sOutputLabel & "<td class='white' colspan='6'>-</td>" & vbCrLf
        Else
          If lineArray(AssetTypeCOL + assetCounter) = "" Then
            ErrorMessage("Asset Type is required, The asset will be ignored.", lineCounter, 2)
            sOutputLabel = sOutputLabel & "<td class='Possible'>-</td>" & vbCrLf
            invalid = True
          Else
            mySelectQuery = "SELECT AssetTypeID FROM AssetType WHERE (EndDate IS NULL) AND (AssetTypeName = '" & lineArray(AssetTypeCOL + assetCounter) & "')"
            MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
            If MyConnection.State.ToString = "Closed" Then
              MyConnection.Open()
            End If
            myReader = MyCommand.ExecuteReader()
            If myReader.Read() Then
              sOutputLabel = sOutputLabel & "<td class='white'>" & lineArray(AssetTypeCOL + assetCounter) & "</td>" & vbCrLf
              AssetType = myReader("AssetTypeID")
            Else
              ErrorMessage("Asset Type '" & lineArray(AssetTypeCOL + assetCounter) & "' is invalid.", lineCounter, 3)
              sOutputLabel = sOutputLabel & "<td class='critical'>" & lineArray(AssetTypeCOL + assetCounter) & "</td>" & vbCrLf
            End If
            myReader.Close()

          End If
          If lineArray(AssetManafacturerCOL + assetCounter) = "" Then
            ErrorMessage("Manafacturer is required, The asset will be ignored.", lineCounter, 2)
            sOutputLabel = sOutputLabel & "<td class='Possible'>-</td>" & vbCrLf
            invalid = True
          Else
            mySelectQuery = "SELECT AssetManufacturerID FROM AssetManufacturer WHERE (EndDate IS NULL) AND (ManufacturerName = '" & lineArray(AssetManafacturerCOL + assetCounter) & "')"
            MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
            If MyConnection.State.ToString = "Closed" Then
              MyConnection.Open()
            End If
            myReader = MyCommand.ExecuteReader()
            If myReader.Read() Then
              sOutputLabel = sOutputLabel & "<td class='white'>" & lineArray(AssetManafacturerCOL + assetCounter) & "</td>" & vbCrLf
              AssetManafacturer = myReader("AssetManufacturerID")
            Else
              ErrorMessage("Asset Manufacturer '" & lineArray(AssetManafacturerCOL + assetCounter) & "' is invalid.", lineCounter, 3)
              sOutputLabel = sOutputLabel & "<td class='critical'>" & lineArray(AssetManafacturerCOL + assetCounter) & "</td>" & vbCrLf
            End If
            myReader.Close()
          End If
          If lineArray(AssetNameCOL + assetCounter) = "" Then
            ErrorMessage("Name is required, The asset will be ignored.", lineCounter, 2)
            sOutputLabel = sOutputLabel & "<td class='Possible'>-</td>" & vbCrLf
            invalid = True
          Else
            If invalid Then
              sOutputLabel = sOutputLabel & "<td class='possible'>" & lineArray(AssetNameCOL + assetCounter) & "</td>" & vbCrLf
            Else
              mySelectQuery = "SELECT AssetListID FROM AssetList WHERE (AssetName = '" & lineArray(AssetNameCOL + assetCounter) & "') AND (AssetTypeID = " & AssetType & ") AND (AssetManufacturerID = " & AssetManafacturer & ") AND (EndDate IS NULL)"
              MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
              If MyConnection.State.ToString = "Closed" Then
                MyConnection.Open()
              End If
              myReader = MyCommand.ExecuteReader()
              If myReader.Read() Then
                sOutputLabel = sOutputLabel & "<td class='white'>" & lineArray(AssetNameCOL + assetCounter) & "</td>" & vbCrLf
                AssetList = myReader("AssetListID")
              Else
                'new
                sOutputLabel = sOutputLabel & "<td class='New'>" & lineArray(AssetNameCOL + assetCounter) & "</td>" & vbCrLf
              End If
              myReader.Close()
            End If
          End If
          If lineArray(IMEESNNumberCOL + assetCounter) = "" Then
            sOutputLabel = sOutputLabel & "<td class='white'>-</td>" & vbCrLf
            If lineArray(AssetNumberCOL + assetCounter) = "" Then
              sOutputLabel = sOutputLabel & "<td class='white'>-</td>" & vbCrLf
            Else
              sOutputLabel = sOutputLabel & "<td class='New'>" & lineArray(AssetNumberCOL + assetCounter) & "</td>" & vbCrLf
            End If
            If lineArray(SerialNumberCOL + assetCounter) = "" Then
              sOutputLabel = sOutputLabel & "<td class='white'>-</td>" & vbCrLf
            Else
              sOutputLabel = sOutputLabel & "<td class='New'>" & lineArray(SerialNumberCOL + assetCounter) & "</td>" & vbCrLf
            End If
          Else
            Dim UserString As String
            Dim ServiceString As String
            Dim ClientString As String
            If sUserID = "" Then
              UserString = ""
            Else
              UserString = " AND (UserID = "REDACTED")"
            End If
            If sServiceID = "" Then
              ServiceString = ""
            Else
              ServiceString = " AND (ServiceID = " & sServiceID & ")"
            End If
            If sClientID = "" Then

            End If
            mySelectQuery = "SELECT IMENumber, AssetNumber, SerialNumber FROM Asset WHERE (AssetlistID = " & AssetList & ")" & UserString & ServiceString & " AND (ClientID = " & sClientID & ") AND (EndDate IS NULL)"
            MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
            If MyConnection.State.ToString = "Closed" Then
              MyConnection.Open()
            End If
            myReader = MyCommand.ExecuteReader()
            If myReader.Read() Then
              sOutputLabel = sOutputLabel & "<td class='white'>" & lineArray(IMEESNNumberCOL + assetCounter) & "</td>" & vbCrLf
              sOutputLabel = sOutputLabel & "<td class='white'>" & lineArray(AssetNumberCOL + assetCounter) & "</td>" & vbCrLf
              sOutputLabel = sOutputLabel & "<td class='white'>" & lineArray(SerialNumberCOL + assetCounter) & "</td>" & vbCrLf
            Else
              sOutputLabel = sOutputLabel & "<td class='New'>" & lineArray(IMEESNNumberCOL + assetCounter) & "</td>" & vbCrLf
              sOutputLabel = sOutputLabel & "<td class='New'>" & lineArray(AssetNumberCOL + assetCounter) & "</td>" & vbCrLf
              sOutputLabel = sOutputLabel & "<td class='New'>" & lineArray(SerialNumberCOL + assetCounter) & "</td>" & vbCrLf
            End If
            myReader.Close()
          End If
        End If
      Next
    End If
  End Sub
  Sub SetColCount()
    ServiceNumberCOL = sOrgLevels + 1
    FirstNameCOL = sOrgLevels + 2
    LastNameCOL = sOrgLevels + 3
    CarrierNameCOL = sOrgLevels + 4
    'ServiceTypeCOL = serviceTypeCOL + 5
    AccountNumberCOL = sOrgLevels + 6
    RatePlanCOL = sOrgLevels + 7
