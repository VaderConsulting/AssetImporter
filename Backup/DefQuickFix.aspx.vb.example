    Private Sub Page_Load(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles MyBase.Load
    'Put user code to initialize the page here
    MyConnection = New System.Data.SqlClient.SqlConnection(Session("OperationalDB"))
    MyConnection2 = New System.Data.SqlClient.SqlConnection(Session("OperationalDB"))
    MyCommand.CommandTimeout = 60

    End Sub

  Private Sub btnGO_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnGO.Click
    Dim counter As Integer
    counter = 0
    If MyConnection2.State.ToString = "Closed" Then
      MyConnection2.Open()
    End If

    mySelectQuery = "SELECT * FROM (SELECT ServiceID, COUNT(UID) AS counter FROM Service WHERE (ClientID = 15) AND (EndDate IS NULL) GROUP BY ServiceID) tbl1 WHERE (counter > 1)"
    Trace.Write(mySelectQuery)
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)

    If MyConnection.State.ToString = "Closed" Then
      MyConnection.Open()
    End If
    myReader = MyCommand.ExecuteReader()
    If myReader.HasRows Then
      Do While myReader.Read()
        If counter < 1000 Then
          mySelectQuery = "SELECT TOP 1 UID FROM Service WHERE ServiceID = " & myReader("ServiceID")
          Trace.Write(mySelectQuery)
          MyCommand2 = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection2)

          If MyConnection2.State.ToString = "Closed" Then
            MyConnection2.Open()
          End If
          myReader2 = MyCommand2.ExecuteReader()

          myReader2.Read()
          mySelectQuery = "UPDATE Service SET EndDate = '27/04/2006' WHERE UID = "REDACTED"UID")
          Trace.Write(mySelectQuery)
          myReader2.Close()
          MyCommand2 = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection2)
          'MyConnection.Open()
          MyCommand2.ExecuteNonQuery()
          'MyConnection.Close()
          counter = counter + 1
        End If
      Loop
    End If
    myReader.Close()

  End Sub
