  Protected WithEvents lblOutput As System.Web.UI.WebControls.Label

  'Database Connection Details
  Dim mySqlDataReader As System.Data.SqlClient.SqlDataReader
  Dim MyConnection As System.Data.SqlClient.SqlConnection
  Dim MyConnection2 As System.Data.SqlClient.SqlConnection
  Dim MyConnection3 As System.Data.SqlClient.SqlConnection
  Dim mySelectQuery As String
  Dim myReader As System.Data.SqlClient.SqlDataReader
  Dim myReader2 As System.Data.SqlClient.SqlDataReader
  Dim myReader3 As System.Data.SqlClient.SqlDataReader
  Dim MyCommand As New System.Data.SqlClient.SqlCommand
  Dim MyCommand2 As New System.Data.SqlClient.SqlCommand

  'Other Variables
  Dim FileLocation As String
  Dim LogString As String
  Dim LogFileName As String
  Dim file As System.IO.StreamWriter
  Dim lineCounter As Integer
  Dim line As String
  Dim OrgUnitParentID As String
  Dim sClientID As String

  'NOTE: The following placeholder declaration is required by the Web Form Designer.
