    Private Sub Page_Load(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles MyBase.Load

    If Not IsPostBack Then
      Response.Write("<form name=StatusForm>" & vbCrLf)
      Response.Write("Processing Line : <input type=text name=tbxStatus width='400'>" & vbCrLf)
      Response.Write("</form>" & vbCrLf)
      Response.Write("<LINK id=stylesheet href=""" & Session("Style") & """ type=text/css rel=stylesheet>" & vbCrLf)

      Dim LogFileName As String
      LogFileName = Left(Request("FileName"), (Len(Request("FileName")) - 4)) & "-" & Session("UsersName") & "-"

      If Day(Now) < 10 Then
        LogFileName = LogFileName & "0" & Day(Now)
      Else
        LogFileName = LogFileName & Day(Now)
      End If
      If Month(Now) < 10 Then
        LogFileName = LogFileName & "0" & Month(Now)
      Else
        LogFileName = LogFileName & Month(Now)
      End If
      LogFileName = LogFileName & Year(Now) & "-"
      If Hour(Now) < 10 Then
        LogFileName = LogFileName & "0" & Hour(Now)
      Else
        LogFileName = LogFileName & Hour(Now)
      End If
      If Minute(Now) < 10 Then
        LogFileName = LogFileName & "0" & Minute(Now)
      Else
        LogFileName = LogFileName & Minute(Now)
      End If
      If Second(Now) < 10 Then
        LogFileName = LogFileName & "0" & Second(Now)
      Else
        LogFileName = LogFileName & Second(Now)
      End If

      LogFileName = LogFileName & ".txt"

      FileLocation = Server.MapPath("LogFiles") & "\" & LogFileName
      file = New System.IO.StreamWriter(FileLocation)
      hlLogFile.NavigateUrl = "LogFiles\" & LogFileName

      'Put user code to initialize the page here
      MyConnection = New System.Data.SqlClient.SqlConnection(Session("OperationalDB"))
      MyConnection2 = New System.Data.SqlClient.SqlConnection(Session("OperationalDB"))
      MyConnection3 = New System.Data.SqlClient.SqlConnection(Session("OperationalDB"))
      MyCommand.CommandTimeout = 300

      Call GetFileDetails()
      If Right(Request("FileName"), 3) = "csv" Then
        Call GetCSVData()
      ElseIf Right(Request("FileName"), 3) = "xls" Then
        Call GetExcelData()
      Else
        Call ErrorMessage("Invalid File Type", 0, 3)
      End If
      file.WriteLine("End File")
      file.Close()
      Response.Write("<script> document.StatusForm.tbxStatus.value='Complete'; </script>" & vbCrLf)
    End If
    End Sub
    Sub GetFileDetails()
        lineCounter = 1
        mySelectQuery = "SELECT * FROM ImportAssetRegister WHERE UID = "REDACTED"UID")
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)

        If MyConnection.State.ToString = "Closed" Then
            MyConnection.Open()
        End If
        myReader = MyCommand.ExecuteReader()
        myReader.Read()

        sUploadFileName = myReader("UploadFileName").ToString()
        suploadDate = myReader("uploadDate").ToString()
        sUploadUser = myReader("UploadUser").ToString()
        sUploadChecked = myReader("UploadChecked").ToString()
        sUploadVerified = myReader("UploadVerified").ToString()
        sUploadSuccessful = myReader("UploadSuccessful").ToString()
        sUploadRemoved = myReader("UploadRemoved").ToString()
        sUploadFormat = myReader("UploadFormat").ToString()
        sClientID = myReader("ClientID").ToString()
        sRevisionNumber = myReader("RevisionNumber").ToString()
        sImportedBy = myReader("ImportedBy").ToString()
        sImportType = myReader("ImportType").ToString()
        sMoveType = myReader("MoveType").ToString()
        sMoveDate = myReader("MoveDate").ToString()
        ImportStateID = myReader("ImportState").ToString()

        'set lables
        lblClientname.Text = getClientName(sClientID)
        lblFileName.Text = sUploadFileName
        lblRevisionNumber.Text = sRevisionNumber
        lblDateUploaded.Text = suploadDate
        lblImportedBy.Text = sImportedBy
        lblOrgUnitlevels.Text = sOrgLevels
        lblImportType.Text = GetImportType(sImportType)
        lblMoveType.Text = GetMoveType(sMoveType)
        lblMoveDate.Text = sMoveDate
        myReader.Close()

        LogString = LogString & "Client Name: " & lblClientname.Text & vbCrLf
        LogString = LogString & "File Name: " & lblFileName.Text & vbCrLf
        LogString = LogString & "Revision Number: " & lblRevisionNumber.Text & vbCrLf
        LogString = LogString & "Date Uploaded: " & lblDateUploaded.Text & vbCrLf
        LogString = LogString & "Imported By: " & lblImportedBy.Text & vbCrLf
        LogString = LogString & "Import Type: " & lblImportType.Text & vbCrLf
        LogString = LogString & "Move Type: " & lblMoveType.Text & vbCrLf
        If lblMoveType.Text = "Move From" Then
            LogString = LogString & "Move Date: " & lblMoveDate.Text & vbCrLf
        End If

        LogString = LogString & vbCrLf & "--------------------" & vbCrLf & vbCrLf

        WriteLogToFile(LogString)

        'Remove All org units listed in the Temp Table for the selected client
        mySelectQuery = "DELETE FROM ImportTempOrgUnits WHERE (ClientID = " & sClientID & ")"
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
        If MyConnection.State.ToString = "Closed" Then
            MyConnection.Open()
        End If
        MyCommand.ExecuteNonQuery()
        MyConnection.Close()
        mySelectQuery = "DELETE FROM ImportTempService WHERE (ClientID = " & sClientID & ")"
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
        If MyConnection.State.ToString = "Closed" Then
            MyConnection.Open()
        End If
        MyCommand.ExecuteNonQuery()
        MyConnection.Close()

        'Insert all the current org units and their respective Parents into the Temp Table
        mySelectQuery = "SELECT OrgUnitID, OrgUnitParent, OrgUnitName FROM ClientOrganisationUnit WHERE (ClientID  = " & sClientID & ")"
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
        If MyConnection.State.ToString = "Closed" Then
            MyConnection.Open()
        End If
        myReader = MyCommand.ExecuteReader()
        Do While myReader.Read()
            'Insert org unit into Temp Table
            mySelectQuery = "INSERT INTO ImportTempOrgUnits (orgID, name, parent, clientID) VALUES ('" & myReader("OrgUnitID") & "', '" & LCase(Trim(myReader("OrgUnitName"))) & "', " & Replace(myReader("OrgUnitParent"), "'", "''") & ", " & sClientID & ")"
            'Trace.Write(mySelectQuery)
            MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
            If MyConnection3.State.ToString = "Closed" Then
                MyConnection3.Open()
            End If
            MyCommand.ExecuteNonQuery()
            MyConnection3.Close()
        Loop
        myReader.Close()

    End Sub
    Function getClientName(ByVal ClientID)
        mySelectQuery = "SELECT ClientName FROM Client WHERE ClientID = " & ClientID
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection2)
        If MyConnection2.State.ToString = "Closed" Then
            MyConnection2.Open()
        End If
        myReader2 = MyCommand.ExecuteReader()
        myReader2.Read()
        Return myReader2("ClientName")
        myReader2.Close()
    End Function
    Public Function GetImportType(ByVal typeID)
        If typeID = "1" Then
            Return "Add Assets"
        ElseIf typeID = "2" Then
            Return "Skip Assets"
        ElseIf typeID = "3" Then
            Return "Update Assets"
        ElseIf typeID = "4" Then
            Return "Org Structure"
        Else
            Return "Error"
        End If
    End Function
    Public Function GetMoveType(ByVal typeID)
        If typeID = "1" Then
            Return "Move All"
        ElseIf typeID = "2" Then
            Return "Move From"
        ElseIf typeID = "3" Then
            Return "Don't Move"
        Else
            Return "Error"
        End If
    End Function
    Sub GetCSVData()
        Dim FileLocation As String
        FileLocation = Server.MapPath("AssetSheets") & "\" & Request("FileName")
        Dim sr As StreamReader = New StreamReader(FileLocation)
        Dim line As String
        Dim counter As Integer
        counter = 0
        Do
            line = sr.ReadLine()
            line = Replace(Trim(line), "'", "''")
            line = Replace(Trim(line), """", "")

            If lineCounter > 2 Then
                If counter > 2 Then
                    line = Nothing
                ElseIf Left(Trim(line), 2) = ",," Or Trim(line) = "" Then
                    Call ErrorMessage("Line Skipped", lineCounter, 2)
                    LogString = LogString & "Line skipped : " & lineCounter & vbCrLf
                    counter = counter + 1
                Else
                    counter = 0
                    Dim aLine() = Split(line, ",")
                    Call ProcessData(aLine)
                End If
            Else
                If lineCounter = 2 Then
                    'Read in and return org levels
                    Call ProcessTitle(line)
                End If
            End If
            lineCounter = lineCounter + 1
        Loop Until line Is Nothing
        sr.Close()
        LogString = LogString & ">>END FILE<<"
    End Sub
    Sub GetExcelData()

        Dim conn As New OleDbConnection
        Dim fileReader As OleDbDataReader
        Dim connString As String
        Dim cmd As New OleDbCommand
        Dim FilePath As String
        Dim lineArray As Array
        Dim FileLocation As String
        FileLocation = Server.MapPath("AssetSheets") & "\" & Request("FileName")

        ' Set the connection string.
        connString = "Data Source='" & FileLocation & "';Provider=Microsoft.Jet.OLEDB.4.0;Extended Properties=""Excel 8.0;IMEX=1;HDR=NO;"""

        ' Open the connection.
        conn.ConnectionString = connString
        conn.Open()

        'get the sheet names
        Dim dt As DataTable
        dt = conn.GetOleDbSchemaTable(OleDbSchemaGuid.Tables, Nothing)
        Dim excelSheets() As String = New String(dt.Rows.Count) {}
        Dim i As Integer = 0
        'get the sheet names
        Dim row As DataRow
        For Each row In dt.Rows
            excelSheets(i) = row("TABLE_NAME").ToString()
            i = i + 1
        Next
        i = 0

        'Set the command properties.
        cmd.Connection = conn
        cmd.CommandText = "SELECT * FROM [" & excelSheets(0) & "]"

        ' Get the OleDbDataReader
        ' and do some processing with it.
        fileReader = cmd.ExecuteReader(CommandBehavior.CloseConnection)
        lineCounter = 1
        Dim counter As Integer = 0
        While (fileReader.Read())
            'Load in file details
            If counter < 2 Then
                If lineCounter <> 1 Then
                    Dim line As String
                    i = 0
                    line = ""
                    While i < fileReader.FieldCount - 1
                        line = line & Trim(fileReader(i).ToString()) & ","
                        i = i + 1
                    End While

                    line = Replace(Trim(line), "'", "''")
                    line = Replace(Trim(line), """", "")

                    If Left(line, 10) = ",,,,,,,,,," Then
                        Call ErrorMessage("Line Skipped", lineCounter, 2)
                        counter = counter + 1
                    Else
                        counter = 0
                        'Trace.Write(lineCounter & " : " & line)
                        If lineCounter = 2 Then
                            ProcessTitle(line)
                        Else
                            Dim aLine() = Split(line, ",")
                            Call ProcessData(aLine)
                        End If

                    End If
                End If
                lineCounter = lineCounter + 1
            End If

        End While
        fileReader.Close()
        LogString = LogString & ">>END FILE<<"

    End Sub
    Sub ProcessTitle(ByVal line)
        Dim aLine() = Split(line, ",")
        Call SetOrgUnitLevels(aLine)
    End Sub
    Sub SetOrgUnitLevels(ByVal aline As Array)
        Dim i As Object
        Dim zz As Boolean
        Dim orgLevels As Integer
        zz = True
        orgLevels = 0
        For Each i In aline
            If zz Then
                If sImportType.ToString() = "4" Then
                    If aline(orgLevels).ToString() <> "Destination Org Unit" Then
                        orgLevels = orgLevels + 1
                    Else
                        sOrgLevels = orgLevels ' - 1
                        zz = False
                    End If
                Else
                    If aline(orgLevels).ToString() <> "Service Number" Then
                        orgLevels = orgLevels + 1
                    Else
                        sOrgLevels = orgLevels - 1
                        zz = False
                    End If
                End If
            End If
        Next i
        lblOrgUnitlevels.Text = sOrgLevels
        Call SetColCount()
        Call CheckAssetCount(UBound(aline))

    End Sub
    Sub CheckAssetCount(ByVal arrayLength)
        noAssets = Math.Ceiling((arrayLength - Feature0COL) / 6)
        If noAssets < 0 Then
            noAssets = 0
        End If
    End Sub
