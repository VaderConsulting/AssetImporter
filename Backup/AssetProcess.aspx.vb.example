        ContractEndDateCOL = sOrgLevels + 8
        PhoneUserEmailCOL = sOrgLevels + 9
        CostCodeCOL = sOrgLevels + 10
        Custom1COL = sOrgLevels + 11
        Custom2COL = sOrgLevels + 12
        Custom3COL = sOrgLevels + 13
        Custom4COL = sOrgLevels + 14
        EmployeeBudgetCOL = sOrgLevels + 15
        NetworkTypeCOL = sOrgLevels + 16
        Feature1COL = sOrgLevels + 17
        Feature2COL = sOrgLevels + 18
        Feature3COL = sOrgLevels + 19
        Feature4COL = sOrgLevels + 20
        Feature5COL = sOrgLevels + 21
        Feature6COL = sOrgLevels + 22
        Feature7COL = sOrgLevels + 23
        Feature8COL = sOrgLevels + 24
        Feature9COL = sOrgLevels + 25
        Feature0COL = sOrgLevels + 26

        AssetTypeCOL = sOrgLevels + 27
        AssetManafacturerCOL = sOrgLevels + 28
        AssetNameCOL = sOrgLevels + 29
        IMEESNNumberCOL = sOrgLevels + 30
        AssetNumberCOL = sOrgLevels + 31
        SerialNumberCOL = sOrgLevels + 32

    End Sub
    Sub ProcessData(ByVal DetailsArray As Array)
        'Insert Data into Database
        Response.Write("<script> document.StatusForm.tbxStatus.value='" & lineCounter & "'; </script>" & vbCrLf)
        LogString = LogString & "Line Number " & lineCounter & vbCrLf
        Dim i As Integer
        Dim DetailsLength As String
        If sImportType <> "2" Or sImportType <> 4 Then
            Call CheckAssetCount(UBound(DetailsArray))
        End If
        DetailsArray = CheckArraySize(DetailsArray)
        OrgUnitParentID = 0
        OrgUnitLevel = 0

        For i = 0 To sOrgLevels - 1
            Call ProcessOrgUnit(DetailsArray(i), OrgUnitParentID)
        Next

        If sImportType.ToString() <> "4" Then
            Call ProcessService(Trim(DetailsArray(ServiceNumberCOL)), Trim(DetailsArray(CarrierNameCOL)), Trim(DetailsArray(AccountNumberCOL)), Trim(DetailsArray(RatePlanCOL)), Trim(DetailsArray(ContractEndDateCOL)), Trim(DetailsArray(NetworkTypeCOL)), Trim(DetailsArray(Feature1COL)), Trim(DetailsArray(Feature2COL)), Trim(DetailsArray(Feature3COL)), Trim(DetailsArray(Feature4COL)), Trim(DetailsArray(Feature5COL)), Trim(DetailsArray(Feature6COL)), Trim(DetailsArray(Feature7COL)), Trim(DetailsArray(Feature8COL)), Trim(DetailsArray(Feature9COL)), Trim(DetailsArray(Feature0COL)))
            Call ProcessUser(Trim(DetailsArray(FirstNameCOL)), Trim(DetailsArray(LastNameCOL)), Trim(DetailsArray(PhoneUserEmailCOL)), Trim(DetailsArray(CostCodeCOL)), Trim(DetailsArray(Custom1COL)), Trim(DetailsArray(Custom2COL)), Trim(DetailsArray(Custom3COL)), Trim(DetailsArray(Custom4COL)), Trim(DetailsArray(EmployeeBudgetCOL)))
            If sImportType <> "2" Then
                Call ProcessAssets(DetailsArray)
            End If
            Call CheckRelocation()
        End If
        LogString = LogString & vbCrLf
        WriteLogToFile(LogString)

    End Sub
    Sub ProcessExistingDetails(ByVal UserFirstName, ByVal UserLastName, ByVal OrgUnit, ByVal ServiceNumber)

    End Sub
    Function ProcessOrgUnit(ByVal OrgUnitName, ByVal ParentID)
        'check where parentID = 0 and Name matches, if not then caution output
        If OrgUnitName = "" Then
            'Skip
            LogString = LogString & "Org Unit Skipped" & vbCrLf
        Else
            mySelectQuery = "SELECT OrgUnitID, OrgUnitName, OrgUnitParent FROM ClientOrganisationUnit WHERE OrgUnitName = '" & OrgUnitName & "' AND OrgUnitParent = " & ParentID & " AND EndDate IS NULL AND  ClientID = " & sClientID
            MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
            If MyConnection.State.ToString = "Closed" Then
                MyConnection.Open()
            End If
            myReader = MyCommand.ExecuteReader()
            If myReader.Read() Then
                'ok
                LogString = LogString & "Org Unit Loaded: " & OrgUnitName & "(" & myReader("OrgUnitID") & ")" & vbCrLf
                OrgUnitParentID = myReader("OrgUnitID")
            Else
                'caution, check for org unit in different location.
                myReader.Close()

                mySelectQuery = "SELECT OrgUnitID, OrgUnitName, OrgUnitParent FROM ClientOrganisationUnit WHERE OrgUnitName = '" & OrgUnitName & "' AND EndDate IS NULL AND ClientID = " & sClientID
                MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection2)
                If MyConnection2.State.ToString = "Closed" Then
                    MyConnection2.Open()
                End If
                myReader2.Close()
                myReader2 = MyCommand.ExecuteReader()
                If myReader2.Read() Then
                    ErrorMessage("Org Unit <b>'" & OrgUnitName & "'</b> structure invalid", lineCounter, 3)
                Else
                    OrgUnitLevel = OrgUnitLevel + 1
                    Call InsertNewOrgUnit(OrgUnitName, ParentID, OrgUnitLevel)
                End If
                myReader2.Close()

            End If
            myReader.Close()
        End If
    End Function
  Sub ProcessService(ByVal ServiceNumber, ByVal Carrier, ByVal AccountNumber, ByVal RatePlan, ByVal ContractEndDate, ByVal NetworkType, ByVal Feature1, ByVal Feature2, ByVal Feature3, ByVal Feature4, ByVal Feature5, ByVal Feature6, ByVal Feature7, ByVal Feature8, ByVal Feature9, ByVal Feature0)

    'dont forget the Service Type, 2 = Mobile Phone

    Dim tempmobile As String
    Dim intCounter As Integer
    Dim ProviderID As Integer
    Dim UpdateString As String
    Dim RatePlanID As String
    Dim ServiceType As Integer

    sServiceID = ""
    tempmobile = ""
    UpdateString = ""

    ' Strip away everything except numerals
    For intCounter = 1 To Len(ServiceNumber)
      If IsNumeric(Mid(ServiceNumber, intCounter, 1)) Then
        tempmobile = tempmobile & Mid(ServiceNumber, intCounter, 1)
      End If
    Next

    ServiceNumber = tempmobile

    If ServiceNumber = "" Then
      'If no service number throw minor error
      Call ErrorMessage("Blank Service", lineCounter, 2)
    Else
      'Load the carrier id into a variable
      mySelectQuery = "SELECT DISTINCT UID, ProviderName, ServiceType  FROM ServiceProvider WHERE (ProviderName = '" & Carrier & "')"
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
      If MyConnection.State.ToString = "Closed" Then
        MyConnection.Open()
      End If
      myReader = MyCommand.ExecuteReader()
      If myReader.Read() Then
        LogString = LogString & "Carrier Loaded: " & Carrier & vbCrLf
        ProviderID = myReader("UID")
        ServiceType = myReader("ServiceType")

        UpdateString = UpdateString & " , ServiceProviderID = " & myReader("UID") & ", ServiceType = " & myReader("ServiceType") & ""
      Else
        ErrorMessage("Carrier <b>'" & Carrier & "'</b> invalid", lineCounter, 3)
        'nothing
      End If
      myReader.Close()

      If AccountNumber = "" Then
        'Nothing
      Else
        UpdateString = UpdateString & " , ProviderAccountNumber = '" & AccountNumber & "'"
      End If

      If RatePlan = "" Then
        'if no rate plan then skip
      Else
        'check for existing, if not add new one
        mySelectQuery = "SELECT * FROM ServiceProviderPlans WHERE PlanName = '" & RatePlan & "' AND ((ServiceProviderID = '" & ProviderID & "') OR (ServiceProviderID IS NULL))"
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
        If MyConnection.State.ToString = "Closed" Then
          MyConnection.Open()
        End If
        myReader = MyCommand.ExecuteReader()
        If myReader.Read() Then
          'return Rate Plan ID
          RatePlanID = myReader("UID")
        Else
          'insert new value
          mySelectQuery = "INSERT INTO ServiceProviderPlans (PlanName, ServiceProviderID) VALUES ('" & RatePlan & "','" & ProviderID & "') ;select @@identity"
          MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
          myReader.Close()
          myReader3 = MyCommand.ExecuteReader()
          myReader3.Read()
          RatePlanID = myReader3.Item(0).ToString()
          myReader3.Close()

        End If
        myReader.Close()
        UpdateString = UpdateString & " , PlanID = " & RatePlanID & ""
      End If

      If ContractEndDate = "" Then
        'nothing
      Else
        UpdateString = UpdateString & " , ContractEndDate = '" & CDate(ContractEndDate) & "'"
      End If


      'Service Options
      Dim NetworkTypeID As String
      mySelectQuery = "SELECT UID FROM NetworkType WHERE (NetworkType = '" & NetworkType & "')"
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
      If MyConnection.State.ToString = "Closed" Then
        MyConnection.Open()
      End If
      myReader = MyCommand.ExecuteReader()
      If myReader.Read() Then
        'return UID for network type
        'nothing
        UpdateString = UpdateString & " , NetworkTypeID = " & myReader("UID").ToString() & ""
      Else
        'insert new uid
        mySelectQuery = "INSERT INTO NetworkType (NetworkType) VALUES ('" & NetworkType & "') ;select @@identity"
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
        myReader.Close()
        myReader3 = MyCommand.ExecuteReader()
        myReader3.Read()
        UpdateString = UpdateString & " , NetworkTypeID = " & myReader3.Item(0).ToString() & ""
        myReader3.Close()
      End If
      myReader.Close()

      'Update Feature 1 
      If LCase(Feature1) = "y" Then
        UpdateString = UpdateString & " , Feature1 = 1"
      ElseIf LCase(Feature1) = "n" Then
        UpdateString = UpdateString & " , Feature1 = 0"
      End If

      'Update Feature 2 
      If LCase(Feature2) = "y" Then
        UpdateString = UpdateString & " , Feature2 = 1"
      ElseIf LCase(Feature2) = "n" Then
        UpdateString = UpdateString & " , Feature2 = 0"
      End If

      'Update Feature 3 
      If LCase(Feature3) = "y" Then
        UpdateString = UpdateString & " , Feature3 = 1"
      ElseIf LCase(Feature3) = "n" Then
        UpdateString = UpdateString & " , Feature3 = 0"
      End If

      'Update Feature 4 
      If LCase(Feature4) = "y" Then
        UpdateString = UpdateString & " , Feature4 = 1"
      ElseIf LCase(Feature4) = "n" Then
        UpdateString = UpdateString & " , Feature4 = 0"
      End If

      'Update Feature 5 
      If LCase(Feature5) = "y" Then
        UpdateString = UpdateString & " , Feature5 = 1"
      ElseIf LCase(Feature5) = "n" Then
        UpdateString = UpdateString & " , Feature5 = 0"
      End If

      'Update Feature 6 
      If LCase(Feature6) = "y" Then
        UpdateString = UpdateString & " , Feature6 = 1"
      ElseIf LCase(Feature6) = "n" Then
        UpdateString = UpdateString & " , Feature6 = 0"
      End If

      'Update Feature 7 
      If LCase(Feature7) = "y" Then
        UpdateString = UpdateString & " , Feature7 = 1"
      ElseIf LCase(Feature7) = "n" Then
        UpdateString = UpdateString & " , Feature7 = 0"
      End If

      'Update Feature 8 
      If LCase(Feature8) = "y" Then
        UpdateString = UpdateString & " , Feature8 = 1"
      ElseIf LCase(Feature8) = "n" Then
        UpdateString = UpdateString & " , Feature8 = 0"
      End If

      'Update Feature 9 
      If LCase(Feature9) = "y" Then
        UpdateString = UpdateString & " , Feature9 = 1"
      ElseIf LCase(Feature9) = "n" Then
        UpdateString = UpdateString & " , Feature9 = 0"
      End If

      'Update Feature 0 
      If LCase(Feature0) = "y" Then
        UpdateString = UpdateString & " , Feature0 = 1"
      ElseIf LCase(Feature0) = "n" Then
        UpdateString = UpdateString & " , Feature0 = 0"
      End If


      'Check for existing service 
      mySelectQuery = "SELECT ServiceNumber, ServiceID, UserID, OrgUnitID FROM Service WHERE (EndDate IS NULL) AND (ServiceNumber = '" & ServiceNumber & "') AND (ClientID = " & sClientID & ")"
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
      If MyConnection.State.ToString = "Closed" Then
        MyConnection.Open()
      End If
      myReader = MyCommand.ExecuteReader()
      If myReader.Read() Then
        'old service
        sServiceID = myReader("ServiceID")
        sOldUserID =REDACTED"UserID")
        sOldOrgID = myReader("OrgUnitID")
        LogString = LogString & "Existing Service details loaded : " & ServiceNumber & "" & vbCrLf
      Else
        'new Service
        mySelectQuery = "INSERT INTO Service (ServiceNumber, ClientID) VALUES ('" & ServiceNumber & "', " & sClientID & ") ;select @@identity"
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
        If MyConnection3.State.ToString = "Closed" Then
          MyConnection3.Open()
        End If
        myReader3 = MyCommand.ExecuteReader()
        myReader3.Read()
        sServiceID = myReader3.Item(0).ToString()
        myReader3.Close()
        sOldUserID = ""
        sOldOrgID = ""
        LogString = LogString & "New Service Inserted : " & ServiceNumber & "" & vbCrLf
      End If
      myReader.Close()

      mySelectQuery = "UPDATE Service SET ServiceID = " & sServiceID & " " & UpdateString & " WHERE UID = "REDACTED""
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
      'Trace.Write(mySelectQuery)
      If MyConnection3.State.ToString = "Closed" Then
        MyConnection3.Open()
      End If
      MyCommand.ExecuteNonQuery()
      MyConnection3.Close()
      LogString = LogString & "Service details updated: " & ServiceNumber & "" & vbCrLf

    End If
  End Sub
  Sub ProcessUser(ByVal FirstName, ByVal LastName, ByVal Email, ByVal CostCode, ByVal Custom1, ByVal Custom2, ByVal Custom3, ByVal Custom4, ByVal EmployeeBudget)
    sUserID = ""
    Dim WhereString As String
    If FirstName = "" And LastName = "" Then
      Call ErrorMessage("Blank User", lineCounter, 2)
    Else
      'process user
      If Email = "" Then
        WhereString = WhereString & ""
      Else
        WhereString = WhereString & " , Email = '" & Email & "'"
      End If

      If CostCode = "" Then
        WhereString = WhereString & ""
      Else
        WhereString = WhereString & " , CostCode = '" & CostCode & "'"
      End If

      If Custom1 = "" Then
        WhereString = WhereString & ""
      Else
        WhereString = WhereString & " , Custom1 = '" & Custom1 & "'"
      End If
      If Custom2 = "" Then
        WhereString = WhereString & ""
      Else
        WhereString = WhereString & " , Custom2 = '" & Custom2 & "'"
      End If
      If Custom3 = "" Then
        WhereString = WhereString & ""
      Else
        WhereString = WhereString & " , Custom3 = '" & Custom3 & "'"
      End If
      If Custom4 = "" Then
        WhereString = WhereString & ""
      Else
        WhereString = WhereString & " , Custom4 = '" & Custom4 & "'"
      End If
      If EmployeeBudget = "" Then
        WhereString = WhereString & ""
      Else
        WhereString = WhereString & " , Budget = " & CDbl(EmployeeBudget) & ""
      End If


      mySelectQuery = "SELECT FirstName, LastName, UserID FROM Users WHERE (EndDate IS NULL) AND (ClientID = " & sClientID & ") AND (FirstName = '" & FirstName & "') AND (LastName = '" & LastName & "')"
      'Trace.Write(mySelectQuery)
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
      If MyConnection.State.ToString = "Closed" Then
        MyConnection.Open()
      End If
      myReader = MyCommand.ExecuteReader()
      If myReader.Read() Then
        'Existing User
        sUserID =REDACTED"UserID").ToString()
        LogString = LogString & "User '" & FirstName & " " & LastName & "' Loaded." & vbCrLf
      Else
        'New User
        mySelectQuery = "INSERT INTO Users ( FirstName, LastName, ClientID) VALUES ('" & FirstName & "', '" & LastName & "', " & sClientID & ") ;select @@identity"
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
        If MyConnection3.State.ToString = "Closed" Then
          MyConnection3.Open()
        End If
        myReader3 = MyCommand.ExecuteReader()
        myReader3.Read()
        sUserID =REDACTED
        myReader3.Close()
        LogString = LogString & "New User '" & FirstName & " " & LastName & "' Inserted.(" & sUserID & ")" & vbCrLf
      End If
      myReader.Close()

      'Update User
      mySelectQuery = "UPDATE Users SET UserID = "REDACTED",  OrgUnitID = " & OrgUnitParentID.ToString & " " & WhereString & " WHERE UID = "REDACTED""
      'Trace.Write(mySelectQuery)
      MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
      If MyConnection3.State.ToString = "Closed" Then
        MyConnection3.Open()
      End If
      MyCommand.ExecuteNonQuery()
      MyConnection3.Close()
      LogString = LogString & "User '" & FirstName & " " & LastName & "' Updated(" & sUserID & ")" & vbCrLf

      If sServiceID <> "" Then
        mySelectQuery = "UPDATE Service SET UserID = "REDACTED" WHERE UID = "REDACTED""
        MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
        If MyConnection3.State.ToString = "Closed" Then
          MyConnection3.Open()
        End If
        MyCommand.ExecuteNonQuery()
        MyConnection3.Close()
        LogString = LogString & "Service details Linked" & vbCrLf
      End If
    End If
  End Sub
  Sub ProcessAssets(ByVal lineArray As Array)
    Dim i As Integer
    Dim assetCounter As Integer
    Dim AssetTypeID As Integer
    Dim AssetManufacturerID As Integer
    Dim AssetListID As Integer
    Dim WhereString As String
    Dim AssetID As Integer

    assetCounter = 0

    If noAssets > 0 Then
      For i = 0 To noAssets - 1
        WhereString = ""
        assetCounter = (i * 6)
        If lineArray(AssetTypeCOL + assetCounter) = "" Or lineArray(AssetNameCOL + assetCounter) = "" Then
          'skip
        Else
          'check
          mySelectQuery = "SELECT AssetTypeID FROM AssetType WHERE (EndDate IS NULL) AND (AssetTypeName = '" & Trim(lineArray(AssetTypeCOL + assetCounter)) & "')"
          MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
          If MyConnection.State.ToString = "Closed" Then
            MyConnection.Open()
          End If
          myReader = MyCommand.ExecuteReader()
          If myReader.Read() Then
            AssetTypeID = myReader("AssetTypeID")
          End If
          myReader.Close()

          mySelectQuery = "SELECT AssetManufacturerID FROM AssetManufacturer WHERE  (EndDate IS NULL) AND (ManufacturerName = '" & Trim(lineArray(AssetManafacturerCOL + assetCounter)) & "')"
          MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
          If MyConnection.State.ToString = "Closed" Then
            MyConnection.Open()
          End If
          myReader = MyCommand.ExecuteReader()
          If myReader.Read() Then
            AssetManufacturerID = myReader("AssetManufacturerID")
          End If
          myReader.Close()

          mySelectQuery = "SELECT AssetListID FROM AssetList WHERE (EndDate IS NULL) AND (AssetName  = '" & Trim(lineArray(AssetNameCOL + assetCounter)) & "') AND (AssetTypeID = " & AssetTypeID & ") AND (AssetManufacturerID = " & AssetManufacturerID & ")"
          MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
          If MyConnection.State.ToString = "Closed" Then
            MyConnection.Open()
          End If
          myReader = MyCommand.ExecuteReader()
          If myReader.Read() Then
            AssetListID = myReader("AssetListID")
            LogString = LogString & "Asset Loaded." & vbCrLf
          Else
            'insert new item in asset list
            mySelectQuery = "INSERT INTO AssetList (AssetManufacturerID, AssetTypeID, AssetName, isVisible) VALUES (" & AssetManufacturerID & ", " & AssetTypeID & ", '" & Trim(lineArray(AssetNameCOL + assetCounter)) & "',1) ;select @@identity"
            MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
            If MyConnection3.State.ToString = "Closed" Then
              MyConnection3.Open()
            End If
            myReader3 = MyCommand.ExecuteReader()
            myReader3.Read()
            AssetListID = myReader3.Item(0).ToString()
            myReader3.Close()
            LogString = LogString & "New Asset '" & Trim(lineArray(AssetNameCOL + assetCounter)) & "' Inserted." & vbCrLf

            mySelectQuery = "UPDATE AssetList SET AssetListID = " & AssetListID & " WHERE UID = "REDACTED""
            MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
            If MyConnection3.State.ToString = "Closed" Then
              MyConnection3.Open()
            End If
            MyCommand.ExecuteNonQuery()
            MyConnection3.Close()
          End If
          myReader.Close()

          If Trim(lineArray(IMEESNNumberCOL + assetCounter)) = "" Then
            'skip IME search
            WhereString = ""
            mySelectQuery = "INSERT INTO Asset (UserID, ServiceID, ClientID) VALUES (" & sUserID & ", " & sServiceID & ", " & sClientID & ") ;select @@identity"
            MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
            If MyConnection3.State.ToString = "Closed" Then
              MyConnection3.Open()
            End If
            myReader3 = MyCommand.ExecuteReader()
            myReader3.Read()
            AssetID = myReader3.Item(0).ToString()
            myReader3.Close()
            LogString = LogString & "New Asset '" & Trim(lineArray(AssetNameCOL + assetCounter)) & "' Inserted." & vbCrLf
          Else
            'find asset id related to IME
            mySelectQuery = "SELECT UID, ServiceID, UserID FROM Asset WHERE (EndDate IS NULL) AND (IMENumber   = '" & Trim(lineArray(IMEESNNumberCOL + assetCounter)) & "')"
            MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
            If MyConnection.State.ToString = "Closed" Then
              MyConnection.Open()
            End If
            myReader = MyCommand.ExecuteReader()
            If myReader.Read() Then
              'IME already in database
              'updateime
              AssetID = myReader("UID")
              Dim br As New BillingRelocation
              br.RelocateAssets(AssetID, myReader("ServiceID"), sServiceID, myReader("UserID"), sUserID, sClientID, sOldOrgID, OrgUnitParentID, Session("OperationalDB"))
            Else
              'New IME
              'addime
              mySelectQuery = "INSERT INTO Asset (UserID, ServiceID, ClientID, IMENumber) VALUES (" & sUserID & ", " & sServiceID & ", " & sClientID & ",'" & Trim(lineArray(IMEESNNumberCOL + assetCounter)) & "') ;select @@identity"
              MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
              If MyConnection3.State.ToString = "Closed" Then
                MyConnection3.Open()
              End If
              myReader3 = MyCommand.ExecuteReader()
              myReader3.Read()
              AssetID = myReader3.Item(0).ToString()
              myReader3.Close()
              LogString = LogString & "New Asset Unique Number '" & Trim(lineArray(AssetNameCOL + assetCounter)) & "' Inserted." & vbCrLf

            End If
            myReader.Close()
          End If
          WhereString = WhereString & ", AssetlistID = " & AssetListID & ""
          If Trim(lineArray(AssetNumberCOL + assetCounter)) = "" Then
            'skip
            WhereString = WhereString & ""
          Else
            'update
            WhereString = WhereString & ", AssetNumber = '" & Trim(lineArray(AssetNumberCOL + assetCounter)) & "'"
          End If
          If Trim(lineArray(SerialNumberCOL + assetCounter)) = "" Then
            'skip
            WhereString = WhereString & ""
          Else
            'Update
            WhereString = WhereString & ", SerialNumber = '" & Trim(lineArray(SerialNumberCOL + assetCounter)) & "'"
          End If

          WhereString = WhereString & ", UserID = "REDACTED", ServiceID = " & sServiceID & ", ClientID = " & sClientID & ", OrgUnitID = " & OrgUnitParentID & ""
          mySelectQuery = "UPDATE Asset SET AssetID = " & AssetID & WhereString & " WHERE UID = "REDACTED""
          Trace.Write(mySelectQuery)
          MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection3)
          If MyConnection3.State.ToString = "Closed" Then
            MyConnection3.Open()
          End If
          MyCommand.ExecuteNonQuery()
          MyConnection3.Close()

        End If
      Next
    End If
  End Sub
  Sub InsertNewOrgUnit(ByVal OrgUnitName, ByVal OrgUnitParent, ByVal OrgUnitLevel)
    mySelectQuery = "INSERT INTO ClientOrganisationUnit (OrgUnitName, OrgUnitParent, OrgUnitState, StartDate, clientID, OrgUnitLevel) VALUES ('" & OrgUnitName.ToString() & "', " & OrgUnitParent.ToString & ", " & ImportStateID & ", '" & Now & "', " & sClientID & ", " & OrgUnitLevel & ") ;select @@identity"
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
    myReader.Close()
    myReader3 = MyCommand.ExecuteReader()
    myReader3.Read()
    OrgUnitParentID = myReader3.Item(0).ToString()
    myReader3.Close()
    mySelectQuery = "UPDATE ClientOrganisationUnit SET OrgUnitID = " + OrgUnitParentID.ToString() + " WHERE UID = "REDACTED"Closed" Then
      MyConnection.Open()
    End If
    MyCommand = New System.Data.SqlClient.SqlCommand(mySelectQuery, MyConnection)
    MyCommand.ExecuteNonQuery()
    LogString = LogString & "Org Unit : '" & OrgUnitName & "' Created, Level : " & OrgUnitLevel & vbCrLf
  End Sub
  Function CheckArraySize(ByVal thisLine)
    Dim arrayLength As Integer
    Dim tempStr As String
    Dim i As Integer
    Dim RequiredLength As Integer
    RequiredLength = Feature0COL + (noAssets * 6)
    arrayLength = UBound(thisLine)
    If arrayLength < RequiredLength Then
      tempStr = thisLine(0)
      For i = 1 To arrayLength
        tempStr = tempStr & "," & thisLine(i)
      Next
      For i = 0 To (RequiredLength - arrayLength)
        tempStr = tempStr & ","
      Next
      Return Split(tempStr, ",", -1, 1)
    Else
      Return thisLine
    End If
  End Function
  Sub ErrorMessage(ByVal ErrorText, ByVal ErrorLine, ByVal ErrorType)
    Dim ErrorColor As String
    Dim sErrorType As String
    If ErrorType = 3 Then
      sErrorType = "Critical "
      ErrorColor = "#ff0000"
      CriticalError = True
      btnDone.Visible = False
    ElseIf ErrorType = 2 Then
      sErrorType = "Possible "
      ErrorColor = "#ff6633"
    End If
    LogString = LogString & sErrorType & "Error : " & ErrorText & " On Line :" & ErrorLine & "" & vbCrLf
  End Sub
  Sub CheckRelocation()
    Dim br As New BillingRelocation
    Dim bAllBilling As Boolean
    bAllBilling = False
    If sMoveType <> 3 Then
      If sMoveType = 1 Then
        bAllBilling = True
      End If
      LogString = LogString & "Relocating: " & vbCrLf
      'Trace.Write(sServiceID & ", " & sClientID & ", " & sOldUserID & ", " & sUserID & ", " & sOldOrgID & ", " & OrgUnitParentID & ", " & sMoveDate & ", " & bAllBilling & ", " & Session("OperationalDB")) 
      If sOldOrgID <> "" Then
        If sOldOrgID <> OrgUnitParentID Then
          LogString = LogString & "Relocate User - " & sClientID & " || " & sUserID & " || " & sOldOrgID & " || " & OrgUnitParentID & " || " & sMoveDate & " || " & bAllBilling & " || " & Session("OperationalDB") & vbCrLf
          br.RelocateUser(sClientID, sUserID, sOldOrgID, OrgUnitParentID, sMoveDate, bAllBilling, Session("OperationalDB"))
          'Trace.Write("Relocate User")
          If sOldUserID <> "" Then
            If sOldUserID <> sUserID Then
              LogString = LogString & "Relocate Service - " & sServiceID & " || " & sClientID & " || " & sOldUserID & " || " & sUserID & " || " & sOldOrgID & " || " & OrgUnitParentID & " || " & sMoveDate & " || " & bAllBilling & " || " & Session("OperationalDB") & vbCrLf
              br.RelocateService(sServiceID, sClientID, sOldUserID, sUserID, sOldOrgID, OrgUnitParentID, sMoveDate, bAllBilling, Session("OperationalDB"))
              'Trace.Write("Relocate Service")
            End If
          End If
        End If
      End If
    End If
  End Sub
  Sub WriteLogToFile(ByVal logStr)
    file.Write(logStr)
    tbxLogWindow.Text = tbxLogWindow.Text & LogString
    LogString = ""
  End Sub
  Private Sub btnDone_Click(ByVal sender As System.Object, ByVal e As System.Web.UI.ImageClickEventArgs) Handles btnDone.Click
    Response.Redirect("default.aspx")
  End Sub
End Class
